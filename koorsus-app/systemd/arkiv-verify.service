[Unit]
Description=Arkiv weekly backup verification (rehearse a restore)
After=arkiv.service

[Service]
Type=oneshot
User=root
Group=root
Environment="ARKIV_BACKUP_DIR=/mnt/arkiv-backup"
Environment="ARKIV_INDEX_DIR=/mnt/lake/arkiv_index"
Environment="ARKIV_BACKUP_LOG=/var/log/arkiv-backup.log"
Environment="ARKIV_VERIFY_STATUS=/var/log/arkiv-verify.status"
ExecStart=/home/jeeves/arkiv/verify-backup.sh
