# /etc/myarra/appliance.env
# One env file for the whole appliance. All four units in deploy/ read it.
# Copy to /etc/myarra/appliance.env, fill in what is blank, then:
#   sudo chown root:jeeves /etc/myarra/appliance.env
#   sudo chmod 640 /etc/myarra/appliance.env
# Values left commented out fall back to the built-in defaults in code.

# --- Database ---
MYARRA_DB=/mnt/lake/myarra.db

# --- LLM endpoint ---
# The port must match --port in koorsus-llm.service, which is 8080.
LLM_URL=http://127.0.0.1:8080/v1/chat/completions

# --- TLS for the web app on 5002 ---
MYARRA_TLS_CERT=/home/jeeves/myarra-certs/myarra-cert.pem
MYARRA_TLS_KEY=/home/jeeves/myarra-certs/myarra-key.pem
KOORSUS_TLS_CERT=/home/jeeves/myarra-certs/koorsus-cert.pem
KOORSUS_TLS_KEY=/home/jeeves/myarra-certs/koorsus-key.pem

# --- Model file for llama-server ---
# Nano runs the 3B. NX runs the 7B or 14B and needs the 16GB module.
KOORSUS_MODEL=/home/jeeves/llama.cpp/models/qwen2.5-3b/qwen2.5-3b-instruct-q4_k_m.gguf

# --- Telegram ---
# Myarra floor bot. Leave commented to use the built-in demo token.
#MYARRA_TG_TOKEN=
# Koorsus bot and notifier.
#KOORSUS_TG_TOKEN=
#KOORSUS_TG_CHAT_ID=

# --- Email ---
#KOORSUS_EMAIL_USER=
#KOORSUS_EMAIL_PASSWORD=
#KOORSUS_EMAIL_ALLOWED=

# --- Odoo connector shared secret ---
#MYARRA_ODOO_TOKEN=
