# Template. Copy to /etc/systemd/system/koorsus.service.
# Credentials and LLM_URL come from /etc/myarra/appliance.env, which must
# exist first. The real config.py is gitignored; config.example.py is
# the tracked template it is copied from.
[Unit]
Description=Koorsus web application
After=network.target koorsus-llm.service
Wants=koorsus-llm.service

[Service]
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/myarra/appliance.env
User=jeeves
Group=jeeves
ExecStart=/home/jeeves/jeeves-env/bin/python /home/jeeves/Client-Demo/serve.py
WorkingDirectory=/home/jeeves/Client-Demo
Restart=on-failure
RestartSec=5
Environment="HF_HUB_OFFLINE=1"
Environment="TRANSFORMERS_OFFLINE=1"

[Install]
WantedBy=multi-user.target
